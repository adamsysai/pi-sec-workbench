{
  "name": "pi-sec-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p web/tsconfig.json",
    "test": "node --experimental-strip-types --test sdk/tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "node --experimental-strip-types scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41"
  },
  "pi": {
    "extensions": [
      "./extensions/coordinator.ts"
    ]
  }
}
